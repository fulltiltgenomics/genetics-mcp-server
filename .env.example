# Genetics API URL (the REST API providing data)
GENETICS_API_URL=http://0.0.0.0:2000/api

# BigQuery API URL (for direct SQL queries)
BIGQUERY_API_URL=http://0.0.0.0:8080

# Shared secret sent as a bearer on every call to results-api and the BigQuery API. The deployed
# entrypoints refuse to start without it (and with a non-ASCII value); optional only for a local
# run against services that require no internal auth.
# INTERNAL_API_SECRET=
# Chat backend base URL (ending in /chat) the MCP server validates per-user API tokens and
# runtime access grants against when the two do not share a filesystem
# CHAT_BACKEND_URL=
# Deployment data profile (genetics-results-suite configs/datasets.yaml). Tools only some
# profiles serve are withdrawn everywhere else, failing closed when this is unset.
# CONFIG_PROFILE=

# LLM API Keys (for chat service, optional for MCP-only usage).
# Only ANTHROPIC_API_KEY is usable: since genetics-results-suite-c4s the chat API refuses
# provider="openai" with a 400 before the stream opens. OPENAI_API_KEY is still read and
# still plumbed through, kept for a future reinstatement of the OpenAI path.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Default LLM model for the chat service
DEFAULT_MODEL=claude-fable-5-2
# Who answers when a safety classifier declines a request: "default" (Anthropic picks by
# refusal category), a model id, or empty to show the refusal to the user instead.
# REFUSAL_FALLBACK=default
# Who answers, client side, when a refusal stands after that (no recommended fallback for
# the category, or a streaming decline inside an open tool-use block). Opus 4.8 or Opus 5
# for Fable; empty to show the refusal to the user instead.
# REFUSAL_RETRY_MODEL=claude-opus-5

# Models used by the analyze_conversations script (override its CLI defaults).
# ANALYZE_TOPIC_MODEL=claude-opus-5
# ANALYZE_QUALITY_MODEL=claude-opus-5
# Bearer token replay_benchmark sends when the target chat API requires auth
# REPLAY_AUTH_TOKEN=

# Sampling temperature (optional, off by default). Many current models
# (Fable, Opus 4.7 and later including Opus 5) reject this parameter, so leave
# unset for them.
# TEMPERATURE=0.3

# Output token ceiling per model call. Caps thinking and visible text together,
# and bills only what is generated, so headroom is cheap -- but a single turn
# still has to finish inside the 5-minute per-iteration timeout.
# MAX_TOKENS=16384

# How many times a turn cut short by MAX_TOKENS may be resumed before the
# truncation is reported to the user.
# MAX_CONTINUATIONS=3

# What one user turn may spend (USD) before the model is told to finish from what it has, and
# the unconditional stop above that. 0 disables either.
# MAX_TURN_COST_USD=20.0
# MAX_TURN_COST_HARD_USD=50.0

# Anthropic retries: attempts over connection errors, 5xx and overloaded_error; whether a 429 is
# retried too (off by default: a 429 means capacity is spent, and a waiting user only gets a
# longer spinner; a benchmark turns it on); the cap on an honoured retry-after.
# ANTHROPIC_MAX_RETRIES=3
# ANTHROPIC_RETRY_RATE_LIMIT=false
# ANTHROPIC_RETRY_AFTER_MAX_S=60

# Named system-prompt variant this deployment serves. Empty or unknown serves the default
# (condensed) and logs a warning.
# PROMPT_VARIANT=

# Replayed tool results are cleared from the model's view, oldest first, once the history passes
# the trigger, down to the target; the newest KEEP_TURNS assistant turns keep theirs. Characters,
# not tokens: the server has no tokenizer. 0 disables.
# HISTORY_PRUNE_TRIGGER_CHARS=900000
# HISTORY_PRUNE_TARGET_CHARS=600000
# HISTORY_PRUNE_KEEP_TURNS=2

# How long shutdown waits for chat turns whose clients are gone; keep it inside the pod's
# termination grace period together with uvicorn's own drain
# TURN_DRAIN_TIMEOUT_S=270

# Web search (optional)
TAVILY_API_KEY=tvly-...

# Literature search backend when the chat request names none: "perplexity" (default, requires
# PERPLEXITY_API_KEY) or "europepmc". The model cannot select a backend.
LITERATURE_SEARCH_BACKEND=perplexity
PERPLEXITY_API_KEY=pplx-...
# Set false to withdraw search_scientific_literature (on by default; the benchmark turns it off)
# ENABLE_LITERATURE_SEARCH=true

# Download storage for tool result TSV files
DOWNLOAD_STORAGE_PATH=/mnt/disks/data/downloads
DOWNLOAD_TTL_SECONDS=2592000  # 30 days

# Cap in UTF-8 bytes on one "[File: ...]" attachment reference block in any chat turn. The
# browser mirrors it; a block over it is a client inlining the file, refused with 413.
# MAX_FILE_BLOCK_BYTES=8192

# Attachment storage and per-request size caps (413 before any model call)
# ATTACHMENT_STORAGE_PATH=/mnt/disks/data/attachments
# MAX_ATTACHMENT_SIZE=52428800        # 50 MiB; data files are further capped by the sandbox input limit
# MAX_MESSAGE_CHARS=50000             # typed text in the newest user message
# MAX_ATTACHMENTS_PER_MESSAGE=10
# MAX_REQUEST_CHARS=2000000           # text across all messages, images excluded
# MAX_MESSAGES_PER_REQUEST=500

# Database paths
LLM_CONFIG_DB=/mnt/disks/data/llm_config.db
CHAT_HISTORY_DB=/mnt/disks/data/chat_history.db

# Authentication (optional) - requires IAP or oauth2-proxy to set X-Goog-Authenticated-User-Email header, or custom tokens
REQUIRE_AUTH=false

# Browser origins allowed to call the chat API cross-origin (dev only; prod shares one origin)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Per-user sliding-window limits on POST /chat/v1/chat
# RATE_LIMIT_PER_HOUR=20
# RATE_LIMIT_PER_DAY=40
# RATE_LIMIT_PER_WEEK=100

# Provenance secret auth-gateway sends as X-Gateway-Auth after verifying an oauth2-proxy
# session (genetics-results-suite-4h6.84). Code execution (run_analysis) dispatches only when
# a request carries it, so it must stay DIFFERENT from INTERNAL_API_SECRET — mcp-server and
# results-api hold that one and could otherwise vouch for themselves. Unset with
# REQUIRE_AUTH=true refuses every dispatch; irrelevant with REQUIRE_AUTH=false (local dev has
# no gateway to assert anything, and run_analysis is allowed there).
# GATEWAY_IDENTITY_SECRET=

# MCP server bearer tokens (comma-separated), sent in the Authorization header.
# MCP_API_KEY=

# Accept the token in a ?token=XXX query parameter as well. Off by default: a credential in a
# URL is captured by upstream request logs, browser history and the Referer header. Enable only
# for a client that genuinely cannot set the Authorization header.
# MCP_ALLOW_QUERY_TOKEN=false

# Days of INACTIVITY after which a per-user API token expires; every use extends it by the same
# amount. 0 disables expiry. Applies to tokens created via the chat API, not to MCP_API_KEY.
# API_TOKEN_TTL_DAYS=90

# Allow-list for Google Identity Tokens presented as bearer tokens (JWT branch of bearer auth).
# A token that contains "." is validated as a Google ID token; the verified email must match.
# ALLOWED_EMAILS: comma-separated individual emails (empty = no per-email allow-list)
# ALLOWED_EMAIL_DOMAINS: comma-separated email domains (default: finngen.fi)
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=finngen.fi

# Comma-separated OAuth client ids a Google Identity Token must be addressed to (its `aud`).
# Unset means the audience is not checked at all, so any Google-signed id_token carrying an
# allow-listed email is accepted — including one minted for a different OAuth client. The deployed
# value is the gcloud CLI's *public* client id, which is what `gcloud auth print-identity-token`
# mints, so the check is worth cross-OAuth-client replay protection only, not identity: it rejects
# a token addressed to another client id (ADC's 764086051850-..., a project-owned client), but not
# one the same user handed to another service documenting this same gcloud flow — that token has
# the identical aud. The email allow-list above is the access control. A project-owned client id
# here is not an option — gcloud cannot request a custom audience on user credentials.
# The Google-id_token path itself is DEPRECATED (still supported): per-user API tokens, created
# from the browser's "MCP and API keys" dialog, are the recommended programmatic credential
# because this deployment issues them and can revoke them per user.
# GOOGLE_TOKEN_AUDIENCE=32555940559.apps.googleusercontent.com

# OAuth 2.1 resource server (optional): trust Keycloak-issued access tokens as a
# bearer-validation path. Inert unless both OAUTH_ISSUER and OAUTH_RESOURCE_URL are set.
# Validated tokens still go through the ALLOWED_EMAILS / ALLOWED_EMAIL_DOMAINS allow-list.
# OAUTH_ISSUER: Keycloak realm issuer, e.g. https://auth.example.org/realms/genetics
# OAUTH_RESOURCE_URL: canonical MCP resource URL, the expected token audience
# OAUTH_JWKS_URI: optional; if unset it is derived as <issuer>/protocol/openid-connect/certs
# OAUTH_ISSUER=
# OAUTH_RESOURCE_URL=
# OAUTH_JWKS_URI=

# MCP transport security (set to true only for development)
MCP_DISABLE_TRANSPORT_SECURITY=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Product/brand name used in the assistant persona system prompt (chat-backend only)
APP_NAME=FinnGenie

# myvariant.info variant annotation API (chat-backend only, not exposed on MCP server)
# MYVARIANT_API_URL=https://myvariant.info/v1

# UniProt protein annotation APIs (chat-backend only, not exposed on MCP server)
# UNIPROT_API_URL=https://rest.uniprot.org
# EBI_PROTEINS_API_URL=https://www.ebi.ac.uk/proteins/api
# Response cache lifetime in seconds (default 24h)
# UNIPROT_CACHE_TTL=86400

# ChEMBL drug/target API (chat-backend only, not exposed on MCP server)
# CHEMBL_API_URL=https://www.ebi.ac.uk/chembl/api/data
# Response cache lifetime in seconds (default 24h; ChEMBL releases quarterly)
# CHEMBL_CACHE_TTL=86400

# AlphaGenome Atlas variant predictions (chat-backend only, not exposed on MCP server).
# With the flag off, no key, or both, neither AlphaGenome tool is advertised at all -
# Settings.disabled_tools withdraws both names, and their shared opt-in prompt block goes
# with them, so nothing tells the model about a tool it lacks.
# Per-deployment switch; off by default even if a key is present.
# ALPHAGENOME_ENABLED=true
# ALPHAGENOME_API_KEY=
# In-process prediction cache lifetime in seconds; 0 disables caching. Nothing is persisted.
# ALPHAGENOME_CACHE_TTL=3600

# External MCP servers to proxy (comma-separated, always-on)
# Entry: URL[|option]... where an option is key=value (path=, timeout=, token=, oauth=, tools=, prefix=)
# and anything else is a static bearer token (the URL|TOKEN form). See mcp_proxy.ServerConfig.
# Tools from these servers are always available regardless of tool_profile
# - Open Targets Platform MCP: gene-disease associations, drug targets, GraphQL API
# - C3PO answers at its root, wants a longer timeout, and is behind OAuth with no
#   client-credentials grant: run `python -m genetics_mcp_server.scripts.mcp_oauth_login
#   https://mcp.c3po.bio --path /` once and put its JSON in the env var oauth= names, e.g.
#   https://mcp.c3po.bio|path=/|timeout=120|oauth=C3PO_MCP_OAUTH|prefix=c3po|tools=query_kb+get_kb_query_result
EXTERNAL_MCP_SERVERS=https://mcp.platform.opentargets.org
# C3PO_MCP_OAUTH={"token_endpoint":"...","client_id":"...","refresh_token":"..."}
# Where a rotated OAuth refresh token is persisted; unset, it dies with the process
# EXTERNAL_MCP_STATE_DIR=/data/mcp-oauth

# RAG MCP server: when set, its tools are handed to every request whatever the tool_profile
# Format: URL or URL|AUTH_TOKEN
# RAG_MCP_SERVER=http://...

# Tools to exclude from proxying (comma-separated, useful to avoid duplicates)
EXTERNAL_MCP_EXCLUDE_TOOLS=""

# Optional tools (disabled by default)
ENABLE_CREDIBLE_SETS_STATS=false

# Code execution. False until a sandbox supervisor is actually serving SANDBOX_URL: while
# it is false run_analysis is withheld from every tool list, and the system prompt loses
# its guidance with it. Enabling it without a reachable sandbox steers the model into a
# tool that always fails and looks retryable.
SANDBOX_ENABLED=false
# Sandbox supervisor base URL. No default: an unset value is refused at client construction
# rather than guessed.
# SANDBOX_URL=
# HS256 key for the per-execution sandbox tokens (chat-backend mints, db-api/results-api
# verify). Separate from INTERNAL_API_SECRET; unset means no execution runs.
# SANDBOX_TOKEN_SIGNING_KEY=
# url-fetcher base URL (no default, for the same reason as SANDBOX_URL) and the bounds of the
# in-memory per-user fetch cache; either at or below 0 disables caching
# URL_FETCHER_URL=
# URL_FETCH_CACHE_TTL_SECONDS=900
# URL_FETCH_CACHE_MAX_BYTES=33554432

# Whether this deployment's results-api has a cell-type expression release pointer. Only
# CONFIG_PROFILE=daly can offer get_cell_type_expression at all.
# CELL_TYPE_EXPRESSION_ENABLED=false

# Profile served as chat_tool_profile to users who have not chosen one; empty = the browser's
# own default, which resolves to the no-code surface
# DEFAULT_TOOL_PROFILE=

# Admin page (disabled by default)
ENABLE_ADMIN_PAGE=false
ADMIN_USERS=                           # comma-separated admin email addresses

# Runtime access grants. The button label is the feature switch: empty shows no button, runs no
# reconciler and never writes the grant table. The deadline is ISO 8601 with an offset.
# ACCESS_GRANT_BUTTON_LABEL=
# ACCESS_GRANT_EXPIRES_AT=
# ACCESS_GRANT_CONFIGMAP=             # oauth2-proxy authenticated-emails ConfigMap; empty skips it
# KEYCLOAK_ADMIN_URL=
# KEYCLOAK_REALM=genetics
# KEYCLOAK_ACCESS_GRANTS_CLIENT_ID=access-grants
# KEYCLOAK_ACCESS_GRANTS_CLIENT_SECRET=  # the switch for the Keycloak target
# Notification e-mail over authenticated SMTP (STARTTLS); no host = grants are made, nobody mailed
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# ACCESS_GRANT_EMAIL_FROM=
# ACCESS_GRANT_EMAIL_REPLY_TO=
# ACCESS_GRANT_EMAIL_SUBJECT=
# ACCESS_GRANT_EMAIL_BODY_FILE=       # plain-text body; {email} is replaced with the address

# Keycloak client ids allowed to call POST /provision/{alias} (comma-separated); empty = 404
# BROKER_PROVISIONING_CLIENTS=

# Subagent settings (disabled by default)
ENABLE_SUBAGENTS=false
SUBAGENT_MODEL=                        # defaults to fast_model (claude-haiku-4-5)
SUBAGENT_TIMEOUT=120                   # seconds per subagent
SUBAGENT_ALLOWED_PATHS=                # comma-separated directories subagents can read (read-only)
