# Genetics API URL (the REST API providing data)
GENETICS_API_URL=http://0.0.0.0:2000/api

# BigQuery API URL (for direct SQL queries)
BIGQUERY_API_URL=http://0.0.0.0:8080

# LLM API Keys (for chat service, only one needed and both are optional for MCP-only usage)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Default LLM model for the chat service
DEFAULT_MODEL=claude-opus-5

# Models used by the analyze_conversations script (override its CLI defaults).
# ANALYZE_TOPIC_MODEL=claude-opus-5
# ANALYZE_QUALITY_MODEL=claude-opus-5

# Sampling temperature (optional, off by default). Many current models
# (Fable, Opus 4.7 and later including Opus 5) reject this parameter, so leave
# unset for them.
# TEMPERATURE=0.3

# Output token ceiling per model call. Caps thinking and visible text together,
# and bills only what is generated, so headroom is cheap -- but a single turn
# still has to finish inside the 5-minute per-iteration timeout.
# MAX_TOKENS=16384

# How many times a turn cut short by MAX_TOKENS may be resumed before the
# truncation is reported to the user.
# MAX_CONTINUATIONS=3

# Web search (optional)
TAVILY_API_KEY=tvly-...

# Literature search backend: "europepmc" (default) or "perplexity" - perplexity requires API key
LITERATURE_SEARCH_BACKEND=perplexity
PERPLEXITY_API_KEY=pplx-...

# Download storage for tool result TSV files
DOWNLOAD_STORAGE_PATH=/mnt/disks/data/downloads
DOWNLOAD_TTL_SECONDS=2592000  # 30 days

# Database paths
LLM_CONFIG_DB=/mnt/disks/data/llm_config.db
CHAT_HISTORY_DB=/mnt/disks/data/chat_history.db

# Authentication (optional) - requires IAP or oauth2-proxy to set X-Goog-Authenticated-User-Email header, or custom tokens
REQUIRE_AUTH=false

# MCP server bearer tokens (comma-separated), sent in the Authorization header.
# MCP_API_KEY=

# Accept the token in a ?token=XXX query parameter as well. Off by default: a credential in a
# URL is captured by upstream request logs, browser history and the Referer header. Enable only
# for a client that genuinely cannot set the Authorization header.
# MCP_ALLOW_QUERY_TOKEN=false

# Days of INACTIVITY after which a per-user API token expires; every use extends it by the same
# amount. 0 disables expiry. Applies to tokens created via the chat API, not to MCP_API_KEY.
# API_TOKEN_TTL_DAYS=90

# Allow-list for Google Identity Tokens presented as bearer tokens (JWT branch of bearer auth).
# A token that contains "." is validated as a Google ID token; the verified email must match.
# ALLOWED_EMAILS: comma-separated individual emails (empty = no per-email allow-list)
# ALLOWED_EMAIL_DOMAINS: comma-separated email domains (default: finngen.fi)
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=finngen.fi

# Comma-separated OAuth client ids a Google Identity Token must be addressed to (its `aud`).
# Unset means the audience is not checked at all, so any Google-signed id_token carrying an
# allow-listed email is accepted — including one minted for an unrelated app. The deployed
# value is the gcloud CLI client id, which is what `gcloud auth print-identity-token` mints.
# GOOGLE_TOKEN_AUDIENCE=32555940559.apps.googleusercontent.com

# OAuth 2.1 resource server (optional): trust Keycloak-issued access tokens as a
# bearer-validation path. Inert unless both OAUTH_ISSUER and OAUTH_RESOURCE_URL are set.
# Validated tokens still go through the ALLOWED_EMAILS / ALLOWED_EMAIL_DOMAINS allow-list.
# OAUTH_ISSUER: Keycloak realm issuer, e.g. https://auth.example.org/realms/genetics
# OAUTH_RESOURCE_URL: canonical MCP resource URL, the expected token audience
# OAUTH_JWKS_URI: optional; if unset it is derived as <issuer>/protocol/openid-connect/certs
# OAUTH_ISSUER=
# OAUTH_RESOURCE_URL=
# OAUTH_JWKS_URI=

# MCP transport security (set to true only for development)
MCP_DISABLE_TRANSPORT_SECURITY=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Product/brand name used in the assistant persona system prompt (chat-backend only)
APP_NAME=FinnGenie

# myvariant.info variant annotation API (chat-backend only, not exposed on MCP server)
# MYVARIANT_API_URL=https://myvariant.info/v1

# UniProt protein annotation APIs (chat-backend only, not exposed on MCP server)
# UNIPROT_API_URL=https://rest.uniprot.org
# EBI_PROTEINS_API_URL=https://www.ebi.ac.uk/proteins/api
# Response cache lifetime in seconds (default 24h)
# UNIPROT_CACHE_TTL=86400

# External MCP servers to proxy (comma-separated, always-on)
# Format: URL or URL|AUTH_TOKEN for servers requiring authentication
# Tools from these servers are always available regardless of tool_profile
# - Open Targets Platform MCP: gene-disease associations, drug targets, GraphQL API
EXTERNAL_MCP_SERVERS=https://mcp.platform.opentargets.org

# RAG MCP server (only included when tool_profile is "rag" or unset)
# Format: URL or URL|AUTH_TOKEN
# RAG_MCP_SERVER=http://...

# Tools to exclude from proxying (comma-separated, useful to avoid duplicates)
EXTERNAL_MCP_EXCLUDE_TOOLS=""

# Optional tools (disabled by default)
ENABLE_CREDIBLE_SETS_STATS=false
ENABLE_PHENOTYPE_REPORT=false

# Admin page (disabled by default)
ENABLE_ADMIN_PAGE=false
ADMIN_USERS=                           # comma-separated admin email addresses

# Subagent settings (disabled by default)
ENABLE_SUBAGENTS=false
SUBAGENT_MODEL=                        # defaults to fast_model (claude-haiku-4-5)
SUBAGENT_TIMEOUT=120                   # seconds per subagent
SUBAGENT_ALLOWED_PATHS=                # comma-separated directories subagents can read/write
ENABLE_SCRIPT_EXECUTION=false          # allow subagents to execute Python/R/bash scripts
SUBAGENT_SCRIPT_TIMEOUT=30             # seconds per script execution
